{
  "name": "population-management-system",
  "version": "1.0.0",
  "description": "Hệ thống quản lý nhân khẩu và nhà văn hóa",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate --schema database/schema.prisma",
    "db:push": "prisma db push --schema database/schema.prisma",
    "db:migrate": "prisma migrate dev --schema database/schema.prisma",
    "db:studio": "prisma studio --schema database/schema.prisma",
    "db:seed": "tsx backend/scripts/seed.ts"
  },
  "dependencies": {
    "next": "14.0.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@prisma/client": "5.7.1",
    "prisma": "5.7.1",
    "next-auth": "4.24.5",
    "bcryptjs": "2.4.3",
    "jsonwebtoken": "9.0.2",
    "react-hook-form": "7.48.2",
    "react-hot-toast": "2.4.1",
    "lucide-react": "0.294.0",
    "tailwindcss": "3.3.6",
    "autoprefixer": "10.4.16",
    "postcss": "8.4.32",
    "@headlessui/react": "1.7.17",
    "clsx": "2.0.0",
    "date-fns": "2.30.0",
    "react-calendar": "4.6.0",
    "leaflet": "1.9.4",
    "react-leaflet": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "20.10.5",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.18",
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.5",
    "typescript": "5.3.3",
    "eslint": "8.56.0",
    "eslint-config-next": "14.0.4",
    "tsx": "4.6.2"
  }
